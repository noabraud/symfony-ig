{% extends 'base.html.twig' %}

{% block title %}{{ 'order.show.title'|trans }}{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-100 flex flex-col items-center py-10 px-4">
    <div class="bg-white shadow-lg rounded-2xl w-full max-w-3xl p-8">
        <h1 class="text-2xl font-bold text-center text-gray-800 mb-6">
            {{ 'order.show.title'|trans }}
        </h1>

        <div class="overflow-x-auto">
            <table class="min-w-full border border-gray-200 divide-y divide-gray-200 rounded-lg">
                <tbody class="bg-white divide-y divide-gray-100">
                    <tr>
                        <th class="px-6 py-4 text-left text-sm font-semibold text-gray-600 w-1/3">
                            {{ 'order.order_number'|trans }}
                        </th>
                        <td class="px-6 py-4 text-sm text-gray-700">
                            {{ order.orderNumber }}
                        </td>
                    </tr>
                    <tr>
                        <th class="px-6 py-4 text-left text-sm font-semibold text-gray-600">
                            {{ 'order.created_at'|trans }}
                        </th>
                        <td class="px-6 py-4 text-sm text-gray-700">
                            {{ order.createdAt ? order.createdAt|date('Y-m-d H:i:s') : '' }}
                        </td>
                    </tr>
                    <tr>
                        <th class="px-6 py-4 text-left text-sm font-semibold text-gray-600">
                            {{ 'order.total'|trans }}
                        </th>
                        <td class="px-6 py-4 text-sm font-medium text-gray-800">
                            {{ order.total }} €
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="flex justify-center gap-4 mt-8 flex-wrap">
            <a href="{{ path('app_order_index') }}"
               class="bg-gray-200 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-300 transition duration-200">
                {{ 'order.show.back_to_list'|trans }}
            </a>

            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_order_edit', {'id': order.id}) }}"
                   class="bg-yellow-500 text-white px-4 py-2 rounded-lg hover:bg-yellow-600 transition duration-200">
                    {{ 'order.edit.button'|trans }}
                </a>
            {% endif %}

            {{ include('order/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}
