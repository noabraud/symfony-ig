{{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}

{% for child in form %}
    <div>
        {{ form_label(child, null, {'label_attr': {'class': 'block text-gray-700 font-medium mb-1'}}) }}
        {{ form_widget(child, {
            'attr': {
                'class': 'w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none',
                'placeholder': child.vars.attr.placeholder|default('')|trans
            }
        }) }}
        {{ form_errors(child) }}
    </div>
{% endfor %}

<button 
    class="mt-6 w-full bg-blue-600 text-white font-semibold py-2 rounded-lg hover:bg-blue-700 transition duration-200"
>
    {{ button_label|default('form.save'|trans) }}
</button>

{{ form_end(form) }}
